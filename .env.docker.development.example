# Safe to use as Docker build arguments for local Android development.
APP_ENV=development
NODE_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_OAUTH_SERVER_URL=http://10.0.2.2:3000
EXPO_PUBLIC_ENABLE_DEV_MENU=true

# Use the host LAN IP instead of 10.0.2.2 for a physical device, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000
# EXPO_PUBLIC_OAUTH_SERVER_URL=http://192.168.1.20:3000
