FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile && pnpm store prune
COPY --from=build /app/dist ./dist
COPY scripts/docker-runtime-entrypoint.sh /usr/local/bin/docker-runtime-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-runtime-entrypoint.sh && useradd --create-home --shell /bin/sh appuser && chown -R appuser:appuser /app /usr/local/bin/docker-runtime-entrypoint.sh
USER appuser
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/docker-runtime-entrypoint.sh"]
CMD ["node", "dist/index.js"]
